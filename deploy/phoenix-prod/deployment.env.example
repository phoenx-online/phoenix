# Template only; install the populated file at /srv/phoenix/deployment.env.
# Never store real tokens, production environment files or private keys in Git.
# Use an exact reviewed Git commit SHA for release path.
PHOENIX_RELEASE_DIR=/srv/phoenix/releases/REPLACE_WITH_APPROVED_40_CHAR_SHA

# Both images MUST be pinned by SHA256 manifest digest after operator review.
# Example syntax (not a usable digest):
PHOENIX_NGINX_IMAGE=nginxinc/nginx-unprivileged:stable-alpine@sha256:REPLACE_WITH_APPROVED_64_HEX_DIGEST
PHOENIX_CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.10.0@sha256:REPLACE_WITH_APPROVED_64_HEX_DIGEST
