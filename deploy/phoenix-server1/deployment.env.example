# SERVER 1 /srv/phoenix/deployment.env (copy template; root 0600).
# Values are not approved until pulled, provenance reviewed and digest verified.
# Replace SOURCE_SHA with the exact SHA of the approved public website and deployment scripts.
PHOENIX_RELEASE_DIR=/srv/phoenix/releases/SOURCE_SHA
PHOENIX_NGINX_CONFIG=/srv/phoenix/config/SOURCE_SHA/default.conf

# Pin *real, pulled, trusted, immutable* image digests; never use floating tags here.
PHOENIX_NGINX_IMAGE=nginxinc/nginx-unprivileged:stable-alpine@sha256:REPLACE_WITH_APPROVED_64_HEX_DIGEST
PHOENIX_CLOUDFLARED_IMAGE=cloudflare/cloudflared:latest@sha256:REPLACE_WITH_APPROVED_64_HEX_DIGEST
